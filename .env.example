# Copy to .env and fill in. .env is gitignored.

# ENTSO-E Transparency Platform REST token.
# Register at https://transparency.entsoe.eu/ then request API access (email the helpdesk).
# Elpris ingestion works without this; ENTSO-E ingestion is skipped if unset.
ENTSOE_API_TOKEN=

# Where raw/processed data is written (default: ./data)
ELVARSEL_DATA_DIR=data

# Supabase Postgres connection (Settings -> Database -> Connection string).
# When set, feature loaders read from Postgres instead of local parquet, and
# `python -m elvarsel.storage` syncs the parquet store up. Leave unset to use
# local parquet only.
# postgresql+psycopg://postgres:<password>@db.bbuniyeihpuvqhtjrkjm.supabase.co:5432/postgres
DATABASE_URL=
